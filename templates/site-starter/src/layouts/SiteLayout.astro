---
import { BaseLayout, Container } from "@repo/ui";

import { site } from "../site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const { title, description = site.description, robots } = Astro.props;
const documentTitle = title ? `${title} \u00b7 ${site.name}` : site.name;
const canonicalURL = new URL(Astro.url.pathname, site.url);
---

<BaseLayout
  title={documentTitle}
  description={description}
  canonicalURL={canonicalURL}
  siteName={site.name}
  themeColor={site.themeColor}
  robots={robots}
>
  <slot name="head" slot="head" />
  <slot />
  <footer>
    <Container>
      <a href={site.x} rel="me">Follow on X</a>
    </Container>
  </footer>
</BaseLayout>

<style>
  footer {
    padding-bottom: var(--space-page);
  }

  a {
    color: var(--color-muted);
    font-size: 0.875rem;
    text-underline-offset: 0.18em;
  }

  a:hover {
    color: var(--color-accent);
  }

  a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
