---
import { Container, Prose } from "@repo/ui";

import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../site";
---

<SiteLayout>
  <main>
    <Container>
      <p class="eyebrow">Astro · Cloudflare Workers</p>
      <h1>{site.name}</h1>
      <Prose>
        <p>{site.description}</p>
        <p>
          Replace this page with your content. The deployment, shared
          primitives, and quality gates are already connected.
        </p>
      </Prose>
      <a class="callout" href="https://docs.astro.build">Read the Astro docs</a>
    </Container>
  </main>
</SiteLayout>

<style>
  main {
    display: grid;
    min-height: 100vh;
    align-items: center;
    padding-block: 5rem;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 12ch;
    margin: 0 0 1.5rem;
    font-size: clamp(3.5rem, 12vw, 9rem);
    font-weight: 650;
    letter-spacing: -0.07em;
    line-height: 0.86;
  }

  .callout {
    display: inline-block;
    margin-top: 2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: 0.85rem 1rem;
    text-decoration: none;
  }

  .callout:hover {
    border-color: var(--color-accent);
  }
</style>
