---
import { Container } from "@repo/ui";

import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../site";
---

<SiteLayout>
  <main>
    <Container>
      <h1>{site.name}</h1>
      <p>{site.description}</p>
      <p>Replace this page with your content.</p>
    </Container>
  </main>
</SiteLayout>

<style>
  main {
    padding-block: var(--space-page);
  }

  h1 {
    margin: 0 0 0.75rem;
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
    text-wrap: balance;
  }

  p {
    max-width: var(--prose-width);
    margin: 0;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  p + p {
    margin-top: 0.75rem;
  }
</style>
