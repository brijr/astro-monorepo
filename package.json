{
  "name": "astro-cloudflare-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "site:new": "node scripts/create-site.mjs",
    "site:list": "node scripts/site.mjs list",
    "site:rm": "node scripts/site.mjs rm",
    "site:cf": "node scripts/site.mjs cf",
    "site:check": "node scripts/site.mjs check",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/site.mjs preview",
    "deploy": "node scripts/site.mjs deploy",
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm --recursive --if-present run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test scripts/*.test.mjs",
    "verify": "pnpm format:check && pnpm test && pnpm check && pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.2",
  "devDependencies": {
    "@repo/config": "workspace:*",
    "prettier": "catalog:"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "templates/*"
  ]
}
